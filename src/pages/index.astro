---
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import StageProgression from "../components/homepage/StageProgression.astro";
import { courseMeta } from "../course-config";
import { stages } from "../lib/stages";
import { sessionLabels, siteConfig } from "../site-config";
import "../styles/system.css";
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <section class="masthead" slot="hero" aria-label="Course overview">
    <div class="masthead-lede">
      <p class="field-label masthead-code">
        {courseMeta.code} · {courseMeta.session}, {courseMeta.year}
      </p>
      <h1>{courseMeta.title}</h1>
      <p class="masthead-thesis">{courseMeta.description}</p>
      <ul class="masthead-tags" aria-label="Course tags">
        {courseMeta.tags.map((tag) => <li class="status-tag">{tag}</li>)}
      </ul>
      <p class="masthead-cta">
        <a class="at-button at-button--large" href={withBase("/lectures/week-01/")}>
          Start with Week 1
        </a>
      </p>
      <p class="masthead-caption">
        Twelve teaching weeks, three assessments, and no promise that any of it makes you money — see the
        {" "}<a href={withBase("/policies/")}>course policies</a> for what this course is and isn't.
      </p>
    </div>
    <nav class="masthead-contents" aria-label="The five stages of the course">
      <p class="field-label">Contents</p>
      <ol>
        {
          stages.map((stage) => (
            <li>
              <a href={`#stage-${stage.key}`}>
                <span class="masthead-contents-num">{String(stage.index + 1).padStart(2, "0")}</span>
                <span class="masthead-contents-label">{stage.label}</span>
                <span class="masthead-contents-range">{stage.range}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <StageProgression />

  <section class="home-next" aria-label="Where to go next">
    <p class="field-label">Where to go next</p>
    <ol class="home-next-list">
      <li>
        <a href={withBase("/sessions/")}>
          <span class="home-next-index">01</span>
          <span class="home-next-body">
            <span class="home-next-title">{sessionLabels.plural}</span>
            <span class="home-next-desc">The weekly schedule and what happens in each teaching session.</span>
          </span>
        </a>
      </li>
      <li>
        <a href={withBase("/assessments/")}>
          <span class="home-next-index">02</span>
          <span class="home-next-body">
            <span class="home-next-title">Assessment</span>
            <span class="home-next-desc">What is marked, what it is worth, and when it is due.</span>
          </span>
        </a>
      </li>
      <li>
        <a href={withBase("/people/")}>
          <span class="home-next-index">03</span>
          <span class="home-next-body">
            <span class="home-next-title">People</span>
            <span class="home-next-desc">Who teaches the course and how to reach them.</span>
          </span>
        </a>
      </li>
    </ol>
  </section>
</BaseLayout>

<style>
  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
    gap: var(--at-spacing-2xl);
    padding-block: var(--at-spacing-2xl);
    border-block-end: 1px solid var(--at-divider);
  }

  .masthead-code {
    margin-block-end: 1rem;
  }

  .masthead h1 {
    margin-block: 0 0.85rem;
    font-size: clamp(1.9rem, 3.4vw, 2.65rem);
  }

  .masthead-thesis {
    color: var(--at-text-secondary);
    max-width: 38rem;
    font-size: 1.05rem;
  }

  .masthead-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .masthead-cta {
    margin-block: 0.5rem 1.25rem;
  }

  .masthead-caption {
    max-width: 34rem;
    font-size: 0.85rem;
    color: var(--at-text-muted);
  }

  .masthead-contents {
    border-inline-start: 1px solid var(--at-divider);
    padding-inline-start: var(--at-spacing-lg);
  }

  .masthead-contents ol {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
  }

  .masthead-contents li + li {
    border-block-start: 1px solid var(--at-divider);
  }

  .masthead-contents a {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.6rem;
    padding-block: 0.6rem;
    text-decoration: none;
    color: var(--at-text);
    transition: color 0.15s;
  }

  .masthead-contents a:hover {
    color: var(--at-primary);
  }

  .masthead-contents-num {
    color: var(--at-text-muted);
    font-size: 0.75rem;
  }

  .masthead-contents-label {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .masthead-contents-range {
    grid-column: 2;
    color: var(--at-text-muted);
    font-size: 0.7rem;
  }

  @media (width < 720px) {
    .masthead {
      grid-template-columns: 1fr;
    }

    .masthead-contents {
      border-inline-start: none;
      border-block-start: 1px solid var(--at-divider);
      padding-inline-start: 0;
      padding-block-start: var(--at-spacing-lg);
    }
  }

  .home-next {
    margin-block: var(--at-spacing-2xl) var(--at-spacing-xl);
  }

  .home-next-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    border-block-start: 1px solid var(--at-divider);
  }

  .home-next-list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.1rem;
    border-block-end: 1px solid var(--at-divider);
    text-decoration: none;
    color: var(--at-text);
    transition: padding-inline-start 0.15s, color 0.15s;
  }

  .home-next-list a:hover {
    padding-inline-start: 0.5rem;
    color: var(--at-primary);
  }

  .home-next-index {
    font-family: var(--rm-mono);
    font-size: 0.8rem;
    color: var(--at-text-muted);
    flex-shrink: 0;
  }

  .home-next-body {
    display: grid;
    gap: 0.15rem;
  }

  .home-next-title {
    font-weight: 600;
    font-size: 1.05rem;
  }

  .home-next-desc {
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }
</style>
