---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A rising sequence of flat gold and black candlestick shapes climbing left to right across a warm cream ground, in a two-ink risograph style"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p class="hero-cta">
    <a class="at-button at-button--large" href={withBase("/lectures/week-01/")}>
      Start with Week 1
    </a>
  </p>

  <h2>What you will do</h2>
  <p>
    Place simulated stock orders and trace why they filled where they did.
    Read charts, size positions against a fixed risk percentage, and build
    swing and day-trading plans that separate what you observed from what
    you're assuming. Work the arithmetic behind margin, leverage, futures and
    options by hand, then apply the same risk logic to a simulated crypto
    position. You walk out with a personal rulebook: the instrument, sizing
    and stop-trading rules you'd actually use before risking real money.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone starting from zero — no prior finance, trading or investing
    knowledge assumed. The course is aimed at whoever wants to understand how
    retail markets actually work before deciding whether, and how, to use
    them; it does not assume you already trade, and it will not tell you to
    start.
  </p>

  <h2>How the semester builds</h2>
  <p>
    Twelve weeks in one progression, not twelve unrelated topics: stock
    mechanics and trading styles first, then chart reading and risk, then
    swing and day trading, then leverage, futures, options and crypto, closing
    with a synthesis week. Each week assumes the ones before it. Three pieces
    of graded work track the same arc: the{" "}
    <strong>Market Mechanics Notebook</strong> (20%) checks the early
    mechanics, the <strong>Strategy Lab</strong> (35%) turns chart reading and
    risk into two trade plans, and the <strong>Personal Market Rulebook</strong>{" "}
    (45%) asks you to commit to rules across every instrument covered.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Start with Week 1" href="/lectures/week-01/">
      <p>The first lecture: market overview and basic asset classes.</p>
    </Card>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  .hero-cta {
    margin-block: 0 2rem;
  }
</style>
