---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";
import { stages } from "../lib/stages";
import "../styles/system.css";

const lectures = await getPublishedCollection("lectures");
const byWeek = new Map(lectures.map((lecture) => [lecture.data.week, lecture]));
---

<div class="stage-roster">
  {
    stages.map((stage) => (
      <section class="stage-roster-section" aria-labelledby={`lecture-stage-${stage.key}`}>
        <div class="stage-roster-head">
          <p class="field-label">{stage.range}</p>
          <h2 id={`lecture-stage-${stage.key}`}>{stage.label}</h2>
          <p class="stage-roster-summary">{stage.summary}</p>
        </div>
        <ol class="roster-rows">
          {stage.weeks.map((week) => {
            const lecture = byWeek.get(week.week);
            if (!lecture) return null;
            return (
              <li>
                <a class="roster-row" href={withBase(`/lectures/${lecture.id}/`)}>
                  <span class="roster-row-week">W{String(week.week).padStart(2, "0")}</span>
                  <span class="roster-row-body">
                    <span class="roster-row-title">{lecture.data.title}</span>
                    {lecture.data.description && <span class="roster-row-desc">{lecture.data.description}</span>}
                  </span>
                  <span class="roster-row-date">{formatCourseDate(lecture.data.date)}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
</div>
