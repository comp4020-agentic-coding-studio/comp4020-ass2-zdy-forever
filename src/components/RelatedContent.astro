---
/**
 * Wraps astro-course-university's RelatedContent to disambiguate entries
 * that share a title within the same list --- a lecture and its matching
 * session are always titled identically by design, so a page related to
 * both (e.g. an assessment) would otherwise show the same link text twice
 * pointing at two different pages. Only collisions get a suffix; a page
 * with no title clash renders exactly like the upstream component.
 */
import { getRelatedEntries } from "astro-course-university/content";
import type { GraphEntry } from "astro-course-university/content";
import { sessionLabels } from "../site-config";

interface Props {
  entry: GraphEntry & { data: { links?: { label: string; url: string }[] } };
  collections: string[];
  heading?: string;
}

const { entry, collections, heading = "Related" } = Astro.props;
const related = await getRelatedEntries(entry, collections);
const links = entry.data.links ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const collectionLabels: Record<string, string> = {
  lectures: "Lecture",
  sessions: sessionLabels.singular,
  assessments: "Assessment",
};

const titleCounts = new Map<string, number>();
for (const e of related) {
  titleCounts.set(e.data.title, (titleCounts.get(e.data.title) ?? 0) + 1);
}

function labelFor(e: (typeof related)[number]): string {
  if ((titleCounts.get(e.data.title) ?? 0) < 2) return e.data.title;
  const kind = collectionLabels[e.collection] ?? e.collection;
  return `${e.data.title} (${kind})`;
}
---

{
  (related.length > 0 || links.length > 0) && (
    <aside class="related-content" aria-label={heading}>
      <h2>{heading}</h2>
      <ul>
        {related.map((e) => (
          <li>
            <a href={`${base}/${e.collection}/${e.id}/`}>{labelFor(e)}</a>
          </li>
        ))}
        {links.map((l) => (
          <li class="external">
            <a href={l.url}>{l.label}</a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .related-content {
    margin-block-start: 3rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }

  .related-content h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .related-content ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .related-content .external a::after {
    content: " \2197";
  }
</style>
